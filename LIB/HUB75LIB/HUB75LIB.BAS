REM HUB75 LED matrix control library for MachiKania type P/PU
REM HUB75LIB.BAS

REM Usage:
REM L=NEW(HUB75LIB,WX,WY,SECTNUM,MODE,INTERVAL,SECTPORT,R1,G1,B1,R2,G2,B2,CLK,LAT,OE)
REM  Initialize
REM   WX,WY: Panel Size
REM   SECTNUM: Number of sections (i.e HUB75:16,HUB75E:32)
REM   MODE: Color mode 1:GRB 2:GGRRBB 3:GGGRRRBB
REM   INTERVAL: Timer interrupt interval for every section (us)
REM   SECTPORT: Section GPIO port number (LSB <A>)
REM     Notice! Section(<A>-<E>) must be connected to 4 or 5 consecutive ports
REM   R1,G1,B1,R2,G2,B2,CLK,LAT,OE: GPIO port number

REM Public Methods List
REM LEDON()
REM  Start LED output interrupt
REM LEDOFF()
REM  Stop LED output interrupt
REM CLR()
REM  Clear screen
REM SETP(X,Y,Color)
REM  Set point
REM LIN(X1,Y1,X2,Y2,Color)
REM  Draw line
REM BOX(X1,Y1,X2,Y2,Color)
REM  Draw rectangular
REM BOXF(X1,Y1,X2,Y2,Color)
REM  Draw filled rectangular
REM CIR(X,Y,r,Color)
REM  Draw circle
REM CIRF(X,Y,r,Color)
REM  Draw filled circle
REM PRT(X,Y,Color,Background color,String)
REM  Draw string with System font
REM  Negative Background means transparent
REM TEST(w)
REM  Draw test pattern and call LEDON(), return after w seconds
REM  If w<=0 then wait for -w seconds, then scroll left and up (infinite loop)
REM  No argument means w=-5

REM Notice!
REM This class uses CORETIMER interrupt


STATIC PRIVATE SECTION,BRIGHT,VRAM,ON
STATIC PRIVATE GPIOOESET,GPIOOUT,GPIOSET,GPIOCLR
STATIC PRIVATE R1,G1,B1,R2,G2,B2,LAT,CLK,OE,SECTPORT
STATIC PRIVATE RGBMASK,SECTMASK
STATIC PRIVATE WIDTHX,WIDTHY,NUMSECT,INTERVAL,MODE


METHOD INIT
 WIDTHX=ARGS(1):WIDTHY=ARGS(2):NUMSECT=ARGS(3):MODE=ARGS(4)
 INTERVAL=ARGS(5):SECTPORT=ARGS(6)
 R1=1<<ARGS(7):G1=1<<ARGS(8):B1=1<<ARGS(9)
 R2=1<<ARGS(10):G2=1<<ARGS(11):B2=1<<ARGS(12)
 CLK=1<<ARGS(13):LAT=1<<ARGS(14):OE=1<<ARGS(15)

 REM -------------------------------------
 REM GPIO address for RP2040
 GPIOOESET=$D0000024:REM GPIO output enable set register
 GPIOOUT=$D0000010:REM GPIO output register
 GPIOSET=$D0000014:REM GPIO bit set register
 GPIOCLR=$D0000018:REM GPIO bit clear register

 REM -------------------------------------

 REM GPIO address for RP2350
 REM GPIOOESET=$D0000038:REM GPIO output enable set register
 REM GPIOOUT=$D0000010:REM GPIO output register
 REM GPIOSET=$D0000018:REM GPIO bit set register
 REM GPIOCLR=$D0000020:REM GPIO bit clear register
 REM -------------------------------------

 RGBMASK=R1+G1+B1+R2+G2+B2
 IF NUMSECT>16 THEN
  SECTMASK=$1F<<SECTPORT:REM HUB75E
 ELSE
  SECTMASK=$0F<<SECTPORT:REM HUB75
 ENDIF

 REM Initialize GPIO port for output
 POKE32 GPIOOESET,RGBMASK+SECTMASK+CLK+LAT+OE

 DIM VRAM((WIDTHX*WIDTHY+3)/4-1)
 ON=0

RETURN

METHOD TEST
 VAR X,Y,C,R,G,B,I,W
 FOR Y=0 TO WIDTHY-1
  FOR X=0 TO WIDTHX-1
   C=X*8/WIDTHX
   G=C>>2:R=(C>>1) AND 1:B=C AND 1
   IF MODE=2 THEN
    C=Y*3/WIDTHY+1
    GOSUB SETP,X,Y,(G*C<<4)+(R*C<<2)+B*C
   ELSEIF MODE=3 THEN
    C=Y*7/WIDTHY+1
    GOSUB SETP,X,Y,(G*C<<5)+(R*C<<2)+B*(Y*3/WIDTHY+1)
   ELSE
    GOSUB SETP,X,Y,C
   ENDIF
  NEXT
 NEXT
 GOSUB LEDON
 IF ARGS(0)>0 THEN W=ARGS(1) ELSE W=-5
 IF W>0 THEN DELAYMS W*1000:GOSUB CLR:RETURN
 W=-W
 DO
  DELAYMS W*1000
  FOR I=1 TO WIDTHX
   P=VRAM
   FOR Y=0 TO WIDTHY-1
    C=PEEK(P)
    FOR X=0 TO WIDTHX-2
     POKE P,PEEK(P+1)
     P=P+1
    NEXT
    POKE P,C
    P=P+1
   NEXT
   WAIT 5
  NEXT
  IF MODE=2 OR MODE=3 THEN
   FOR I=1 TO WIDTHY
    P=VRAM
    FOR X=0 TO WIDTHX-1
     C=PEEK(P)
     FOR Y=0 TO WIDTHY-2
      POKE P,PEEK(P+WIDTHX)
      P=P+WIDTHX
     NEXT
     POKE P,C
     P=P-WIDTHX*(WIDTHY-1)+1
    NEXT
    WAIT 5
   NEXT
  ENDIF
 LOOP
RETURN

METHOD LEDON
 IF ON THEN RETURN
 SECTION=0:BRIGHT=0:ON=1
 CORETIMER CORETIMER()+INTERVAL
 INTERRUPT CORETIMER,LEDOUT
RETURN

METHOD LEDOFF
 IF ON=0 THEN RETURN
 ON=0
 INTERRUPT STOP CORETIMER
 POKE32 GPIOSET,OE:REM OUT oebit,1 (OE OFF)
RETURN

METHOD CLR
 VAR I,E
 E=(WIDTHX*WIDTHY+3)/4-1
 FOR I=0 TO E:VRAM(I)=0:NEXT
RETURN

METHOD SETP
 REM Set point x,y,color
 IF ARGS(1)<0 OR ARGS(1)>=WIDTHX OR ARGS(2)<0 OR ARGS(2)>=WIDTHY THEN RETURN
 POKE VRAM+ARGS(2)*WIDTHX+ARGS(1),ARGS(3)
RETURN

METHOD LIN
 VAR X,Y,U,V,P,Q,I,E,C
 X=ARGS(1):Y=ARGS(2)
 C=ARGS(5)
 P=ARGS(3)-X:U=1
 IF P<0 THEN P=-P:U=-1
 Q=ARGS(4)-Y:V=1
 IF Q<0 THEN Q=-Q:V=-1
 IF P>=Q THEN
  E=-P
  FOR I=0 TO P
   GOSUB SETP,X,Y,C
   X=X+U:E=E+Q*2
   IF E>=0 THEN Y=Y+V:E=E-P*2
  NEXT
 ELSE
  E=-Q
  FOR I=0 TO Q
   GOSUB SETP,X,Y,C
   Y=Y+V:E=E+P*2
   IF E>=0 THEN X=X+U:E=E-Q*2
  NEXT
 ENDIF
RETURN

METHOD BOX
 VAR C,X,Y,U,V
 X=ARGS(1):Y=ARGS(2):U=ARGS(3):V=ARGS(4)
 C=ARGS(5)
 GOSUB LIN,X,Y,X,V,C
 GOSUB LIN,U,Y,U,V,C
 GOSUB LIN,X,Y,U,Y,C
 GOSUB LIN,X,V,U,V,C
RETURN

METHOD BOXF
 REM Boxfill x1,y1,x2,y2,color
 VAR A,B,C,D,E
 IF ARGS(1)<=ARGS(3) THEN A=ARGS(1):C=ARGS(3) ELSE A=ARGS(3):C=ARGS(1)
 IF ARGS(2)<=ARGS(4) THEN B=ARGS(2):D=ARGS(4) ELSE B=ARGS(4):D=ARGS(2)
 E=ARGS(5)
 IF A>=WIDTHX OR C<0 THEN RETURN
 IF A<0 THEN A=0
 IF C>=WIDTHX THEN C=WIDTHX-1
 IF B>=WIDTHY OR D<0 THEN RETURN
 IF B<0 THEN B=0
 IF D>=WIDTHY THEN D=WIDTHY-1
 WHILE B<=D
  GOSUB HLINE,A,C,B,E
  B=B+1
 WEND
RETURN

METHOD CIR
 REM Circle x,y,r,color
 VAR X,Y,R,C,P,Q,F
 X=ARGS(1):Y=ARGS(2):R=ARGS(3):C=ARGS(4)
 P=R:Q=0:F=-2*R+3
 WHILE P>=Q
  GOSUB SETP,X-P,Y-Q,C:GOSUB SETP,X+P,Y-Q,C
  GOSUB SETP,X-P,Y+Q,C:GOSUB SETP,X+P,Y+Q,C
  GOSUB SETP,X-Q,Y-P,C:GOSUB SETP,X+Q,Y-P,C
  GOSUB SETP,X-Q,Y+P,C:GOSUB SETP,X+Q,Y+P,C
  IF F>=0 THEN P=P-1:F=F-P*4
  Q=Q+1:F=F+Q*4+2
 WEND
RETURN

METHOD CIRF
 REM Circlefill x,y,r,color
 VAR X,Y,R,C,P,Q,F
 X=ARGS(1):Y=ARGS(2):R=ARGS(3):C=ARGS(4)
 P=R:Q=0:F=-2*R+3
 WHILE P>=Q
  GOSUB HLINE,X-P,X+P,Y-Q,C
  GOSUB HLINE,X-P,X+P,Y+Q,C
  GOSUB HLINE,X-Q,X+Q,Y-P,C
  GOSUB HLINE,X-Q,X+Q,Y+P,C
  IF F>=0 THEN P=P-1:F=F-P*4
  Q=Q+1:F=F+Q*4+2
 WEND
RETURN

LABEL HLINE
 REM Horizontal line x1,x2,y,color
 VAR A,B,C,D
 IF ARGS(1)<=ARGS(2) THEN A=ARGS(1):B=ARGS(2) ELSE A=ARGS(2):B=ARGS(1)
 C=ARGS(3):D=ARGS(4)
 IF A>=WIDTHX OR B<0 THEN RETURN
 IF A<0 THEN A=0
 IF B>=WIDTHX THEN B=WIDTHX-1
 IF C<0 OR C>=WIDTHY THEN RETURN
 WHILE A<=B
  GOSUB SETP,A,C,D
  A=A+1
 WEND
RETURN

METHOD PRT
 REM PRT,X,Y,C,BC,S$
 VAR X,Y,C,B,S,A,I,J,P,D
 X=ARGS(1):Y=ARGS(2)
 C=ARGS(3)
 B=ARGS(4)
 S=ARGS(5)
 DO
  A=PEEK(S):IF A=0 THEN BREAK
  P=SYSTEM(103)+A*8:REM System Font Address
  FOR I=0 TO 7
   D=PEEK(P)
   FOR J=0 TO 7
    IF D AND $80 THEN
     GOSUB SETP,X,Y,C
    ELSEIF B>=0 THEN
     GOSUB SETP,X,Y,B
    ENDIF
    X=X+1:D=D<<1
   NEXT
   P=P+1:X=X-8:Y=Y+1
  NEXT
  X=X+8:Y=Y-8:S=S+1
 LOOP
RETURN


REM -------------------------------------------
REM Interrupt service routine for HUB75 output
REM -------------------------------------------
LABEL LEDOUT
 CORETIMER CORETIMER()+INTERVAL
 VAR I,B,C,D,P,Q
 P=SECTION*WIDTHX+VRAM
 Q=P+WIDTHX*NUMSECT
 FOR I=1 TO WIDTHX
  D=0
  C=PEEK(P)+(PEEK(Q)<<8)
  IF MODE=2 THEN
   IF (C AND 3)>BRIGHT THEN D=B1
   IF ((C>>2) AND 3)>BRIGHT THEN D=D+R1
   IF ((C>>4) AND 3)>BRIGHT THEN D=D+G1
   IF ((C>>8) AND 3)>BRIGHT THEN D=D+B2
   IF ((C>>10) AND 3)>BRIGHT THEN D=D+R2
   IF ((C>>12) AND 3)>BRIGHT THEN D=D+G2
  ELSEIF MODE=3 THEN
   IF (C AND 3)*3-1>BRIGHT THEN D=B1
   IF ((C>>2) AND 7)>BRIGHT THEN D=D+R1
   IF ((C>>5) AND 7)>BRIGHT THEN D=D+G1
   IF ((C>>8) AND 3)*3-1>BRIGHT THEN D=D+B2
   IF ((C>>10) AND 7)>BRIGHT THEN D=D+R2
   IF ((C>>13) AND 7)>BRIGHT THEN D=D+G2
  ELSE
   IF C AND 1 THEN D=B1
   IF C AND 2 THEN D=D+R1
   IF C AND 4 THEN D=D+G1
   IF C AND $100 THEN D=D+B2
   IF C AND $200 THEN D=D+R2
   IF C AND $400 THEN D=D+G2
  ENDIF

  REM output port <G2-B1>,D (RGB OUTPUT)
  POKE32 GPIOSET,D
  POKE32 GPIOCLR,D XOR RGBMASK

  POKE32 GPIOSET,CLK:REM OUT clkbit,1 (CLK ON)
  POKE32 GPIOCLR,CLK:REM OUT clkbit,0 (CLK OFF)
  P=P+1:Q=Q+1
 NEXT

 POKE32 GPIOSET,OE:REM OUT oebit,1 (OE OFF)

 REM output section number
 POKE32 GPIOSET,SECTION<<SECTPORT
 POKE32 GPIOCLR,(SECTION<<SECTPORT) XOR SECTMASK
 POKE32 GPIOSET,LAT:REM OUT latbit,1 (LAT ON)
 POKE32 GPIOCLR,LAT:REM OUT latbit,0 (LAT OFF)
 POKE32 GPIOCLR,OE :REM OUT oebit ,0 (OE ON)

 BRIGHT=BRIGHT+1
 IF (MODE!=2 AND MODE!=3) OR (MODE=2 AND BRIGHT>=3) OR (MODE=3 AND BRIGHT>=7) THEN
  BRIGHT=0
  SECTION=SECTION+1
  IF SECTION>=NUMSECT THEN SECTION=0
 ENDIF
RETURN
