REM QMI8658 class for MachiKania type P ver 0.9

REM Constructor
REM  Q=NEW(QMI8658,a,b,add)
REM  a,b,add are optional

REM Public field
REM  AX#,AY#,AZ# :acceleration
REM  GX#,GY#,GZ# :angular rate

REM Method GETACC()
REM  Get acceleration, angular rate
REM  and update 6 public fields

REM Method GETTAP()
REM  Returns an 8-bit value for tap information
REM  Returns 0 if no taps were detected

REM Method CALIB(ax#,ay#,az#)
REM  Calibrate accelerometer in a stationary state
REM  ax#, ay#, az# are accelerations of each axis in a stationary state

REM Method RESET()
REM  Reset QMI8658

REM ---- Usage example starts here ----

REM Acceleration detection
REM and tap detection

USECLASS QMI8658
CLS
Q=NEW(QMI8658)
Q.CALIB(0,0,-1.0)
DO
 CALL Q.GETACC()
 CURSOR 0,0
 PRINT SPRINTF$("AX:%+.2f",Q.AX#)
 PRINT SPRINTF$("AY:%+.2f",Q.AY#)
 PRINT SPRINTF$("AZ:%+.2f",Q.AZ#)
 PRINT SPRINTF$("GX:%+.2f",Q.GX#)
 PRINT SPRINTF$("GY:%+.2f",Q.GY#)
 PRINT SPRINTF$("GZ:%+.2f ",Q.GZ#)
 T=Q.GETTAP()
 IF T THEN
  CURSOR 30,29
  PRINT HEX$(T)
  PRINT
 ENDIF
 WAIT 1
LOOP

OPTION CLASSCODE

REM -------Class code starts here-------

FIELD PUBLIC AX,AY,AZ,GX,GY,GZ
FIELD PRIVATE OAX,OAY,OAZ,OGX,OGY,OGZ,I2CADD,AFS,GFS,BUF,TAPEN

METHOD INIT
 DIM BUF(2)
 I2C 400
 I2CADD=$6B:AFS=1:GFS=5:TAPEN=0
 OAX#=0:OAY#=0:OAZ#=0:OGX#=0:OGY#=0:OGZ#=0
 IF ARGS(0)>=1 THEN AFS=ARGS(1)
 IF ARGS(0)>=2 THEN GFS=ARGS(2)
 IF ARGS(0)>=3 THEN I2CADD=ARGS(3)
 IF I2CREAD(I2CADD,0)!=5 THEN PRINT "QMI8658 Not Found":END
 GOSUB RESET
 I2CWRITE I2CADD,2,$40
 I2CWRITE I2CADD,3,(AFS<<4)+3
 I2CWRITE I2CADD,4,(GFS<<4)+3
 I2CWRITE I2CADD,8,$03
 AFS#=FLOAT#(1<<AFS)*2/65536/32768
 GFS#=FLOAT#(1<<GFS)*16/65536/32768*PI#/180
 DO
  DELAYMS 1
 LOOP UNTIL (I2CREAD(I2CADD,$2E) AND 3)=3
 GOSUB GETACC
RETURN

METHOD CALIB
 VAR I
 FOR I=1 TO 10
  DO
   DELAYMS 1
  LOOP UNTIL (I2CREAD(I2CADD,$2E) AND 3)=3
  I2CREADDATA I2CADD,BUF,12,$35
  OAX#=OAX#+FLOAT#(PEEK16(BUF+0)<<16)
  OAY#=OAY#+FLOAT#(PEEK16(BUF+2)<<16)
  OAZ#=OAZ#+FLOAT#(PEEK16(BUF+4)<<16)
  OGX#=OGX#+FLOAT#(PEEK16(BUF+6)<<16)
  OGY#=OGY#+FLOAT#(PEEK16(BUF+8)<<16)
  OGZ#=OGZ#+FLOAT#(PEEK16(BUF+10)<<16)
 NEXT
 OAX#=OAX#*AFS#/10-ARGS#(1):OAY#=OAY#*AFS#/10-ARGS#(2):OAZ#=OAZ#*AFS#/10-ARGS#(3)
 OGX#=OGX#*GFS#/10:OGY#=OGY#*GFS#/10:OGZ#=OGZ#*GFS#/10
RETURN

METHOD GETACC
 I2CREADDATA I2CADD,BUF,12,$35
 AX#=FLOAT#(PEEK16(BUF+0)<<16)*AFS#-OAX#
 AY#=FLOAT#(PEEK16(BUF+2)<<16)*AFS#-OAY#
 AZ#=FLOAT#(PEEK16(BUF+4)<<16)*AFS#-OAZ#
 GX#=FLOAT#(PEEK16(BUF+6)<<16)*GFS#-OGX#
 GY#=FLOAT#(PEEK16(BUF+8)<<16)*GFS#-OGY#
 GZ#=FLOAT#(PEEK16(BUF+10)<<16)*GFS#-OGZ#
RETURN

METHOD GETTAP
 IF TAPEN=0 THEN
  I2CWRITE I2CADD,11,30
  I2CWRITE I2CADD,12,1
  I2CWRITE I2CADD,13,100
  I2CWRITE I2CADD,14,0
  I2CWRITE I2CADD,15,44
  I2CWRITE I2CADD,16,1
  I2CWRITE I2CADD,18,1
  GOSUB SENDCOM,$0C
  I2CWRITE I2CADD,11,8
  I2CWRITE I2CADD,12,32
  I2CWRITE I2CADD,13,$20
  I2CWRITE I2CADD,14,3
  I2CWRITE I2CADD,15,$90
  I2CWRITE I2CADD,16,1
  I2CWRITE I2CADD,18,2
  GOSUB SENDCOM,$0C
  I2CWRITE I2CADD,9,1
  TAPEN=1
 ENDIF
 IF I2CREAD(I2CADD,$2F) AND 2 THEN RETURN I2CREAD(I2CADD,$59)
RETURN 0

REM Send CTRL9 Command
LABEL SENDCOM
 I2CWRITE I2CADD,10,ARGS(1)
 DELAYUS 100
 DO UNTIL I2CREAD(I2CADD,$2D) AND $80
  DELAYUS 10
 LOOP
RETURN

REM Rest QMI8658
METHOD RESET
 I2CWRITE I2CADD,$60,$B0:REM Reset QMI8658
 DO
  DELAYMS 1
 LOOP UNTIL I2CREAD(I2CADD,$4D) AND $80
RETURN
