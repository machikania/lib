REM QMI8658 class sample program (6-axis acceleration / gyro sensor)

USECLASS QMI8658
USEVAR ROLL,PITCH,YAW,ALPHA,DT,SAMPLETIME
SAMPLETIME=100:REM 100Hz
ALPHA#=0.9
DT#=1.0/FLOAT#(SAMPLETIME)
ROLL#=0
PITCH#=0
YAW#=0

USEGRAPHIC
Q=NEW(QMI8658)
Q.CALIB(0.0,0.0,-1.0):REM When the sensor is upside down

INTERRUPT TIMER,ORIENT
USETIMER 1000000/SAMPLETIME

DO
 CURSOR 0,0
 PRINT SPRINTF$("AX:%+.3f ",Q.AX#)
 PRINT SPRINTF$("AY:%+.3f ",Q.AY#)
 PRINT SPRINTF$("AZ:%+.3f ",Q.AZ#)
 PRINT SPRINTF$("GX:%+.3f ",Q.GX#)
 PRINT SPRINTF$("GY:%+.3f ",Q.GY#)
 PRINT SPRINTF$("GZ:%+.3f ",Q.GZ#)
 PRINT
 PRINT SPRINTF$("Roll  %+3.0f[deg] ",ROLL#*180/PI#)
 PRINT SPRINTF$("Pitch %+3.0f[deg] ",PITCH#*180/PI#)
 PRINT SPRINTF$("Yaw   %+3.0f[deg] ",YAW#*180/PI#)

 X=-INT(ROLL#*80)+160
 Y=-INT(PITCH#*80)+120
 U=INT(COS#(YAW#)*60)
 V=INT(SIN#(YAW#)*60)
 LINE 160-U,120+V,160+U,120-V,5
 LINE 160+V,120+U,160-V,120-U,5
 CIRCLEFILL X,Y,4,4
 DELAYMS 50
 CIRCLEFILL X,Y,4,0
 LINE 160-U,120+V,160+U,120-V,0
 LINE 160+V,120+U,160-V,120-U,0
LOOP

REM Update orientation
LABEL ORIENT
 VAR R,P
 Q.GETACC()
 R#=ATAN2#(Q.AX#,-Q.AZ#)
 P#=ATAN2#(Q.AY#,SQRT#(Q.AX#*Q.AX#+Q.AZ#*Q.AZ#))
 ROLL#=ROLL#+Q.GY#*DT#
 PITCH#=PITCH#-Q.GX#*DT#
 ROLL#=ALPHA#*ROLL#+(1-ALPHA#)*R#
 PITCH#=ALPHA#*PITCH#+(1-ALPHA#)*P#
 YAW#=YAW#-(SIN#(PITCH#)*Q.GY#-COS#(PITCH#)*Q.GZ#)*DT#/COS#(ROLL#)
RETURN
